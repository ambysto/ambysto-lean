{
  "stryker-config": {
    "project": "Ambysto.Lean.Core.csproj",
    "test-projects": [ "Ambysto.Lean.Core.Tests.csproj" ],
    "test-case-filter": "TestCategory=Console&TestCategory!=SharedState",
    "mutate": [
      "**/Rules/LeanRules.cs",
      "**/Trash/ShellRecycler.cs"
    ],
    "concurrency": 1,
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": [ "json", "cleartext" ],
    "thresholds": { "high": 90, "low": 75, "break": 0 },
    "additional-timeout": 20000
  }
}
