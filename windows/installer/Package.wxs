<!-- Ambysto Lean, per user (intent decision 15; plan group 13): no administrator rights, installed into
     %LOCALAPPDATA%\Programs\Ambysto Lean, a Start Menu shortcut with the notification identity, an uninstall entry
     Windows manages. The journal (%LOCALAPPDATA%\Ambysto\Space) is not part of the package, so uninstalling keeps it.
     The only registry values written are the installer's own: the shortcut component's key path
     (HKCU\Software\Ambysto\Lean, StartMenuShortcut) and the uninstall entry Windows Installer writes. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ambysto Lean" Manufacturer="Ambysto" Version="$(AppVersion)" UpgradeCode="{A0E24189-731D-4A00-A31C-D32E78A09472}" Scope="perUser" Compressed="yes">
    <!-- Hard review 2026-10-18 (MAJOR): an equal version also replaces the installed product (two builds in one minute, or a
         version given twice), so an install never leaves two products and the old files beside the new ones (the owner's
         0xc000027b). The old product is removed inside the install transaction, so a failed upgrade rolls back to it
         instead of leaving no Lean installed. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Ambysto Lean is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="OPTIMER_SELECTED" Secure="yes" />
    <Property Id="DEVBOX_SELECTED" Secure="yes" />
    <!-- The app's icon (generated by scripts/windows-art.py from the brand logo, ASP-13): the shortcut's icon and the
         uninstall entry's icon in Settings > Apps. The installer's bitmaps are generated by the same script. -->
    <Icon Id="LeanIcon.ico" SourceFile="..\src\Ambysto.Lean.App\Assets\AmbystoLean.ico" />
    <Property Id="ARPPRODUCTICON" Value="LeanIcon.ico" />
    <WixVariable Id="WixUIBannerBmp" Value="Art\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Art\Dialog.bmp" />
    <!-- The installer's screens (owner decision 2026-10-18: a finish screen): Welcome, Install, progress, and a finish
         screen whose ticked box opens Lean, as the user who installed it (never elevated). No licence page. The silent
         install (msiexec /qn) shows none of them. WixToolset.UI.wixext is a build-time package of this project only. -->
    <UI Id="LeanUI">
      <!-- 5-screen custom dark installer UI ("The Printed Readout", MsiEmbeddedUI) with Smart Sibling Filtering. -->
      <EmbeddedUI Id="LeanEmbeddedUI" Name="EmbeddedUI.dll" SourceFile="$(EmbeddedUIDll)">
        <EmbeddedUIResource Id="ResScreen1Base" Name="Screen1_Base.png" SourceFile="Art\Screen1_Base.png" />
        <EmbeddedUIResource Id="ResScreen2Base" Name="Screen2_Base.png" SourceFile="Art\Screen2_Base.png" />
        <EmbeddedUIResource Id="ResScreen2Accepted" Name="Screen2_Accepted.png" SourceFile="Art\Screen2_Accepted.png" />
        <EmbeddedUIResource Id="ResScreen2NoOffer" Name="Screen2_NoOffer.png" SourceFile="Art\Screen2_NoOffer.png" />
        <EmbeddedUIResource Id="ResScreen3Base" Name="Screen3_Base.png" SourceFile="Art\Screen3_Base.png" />
        <EmbeddedUIResource Id="ResScreen4Newsletter" Name="Screen4_Newsletter.png" SourceFile="Art\Screen4_Newsletter.png" />
        <EmbeddedUIResource Id="ResScreen5Finish" Name="Screen5_Finish.png" SourceFile="Art\Screen5_Finish.png" />
        <EmbeddedUIResource Id="ResScreen5FinishOff" Name="Screen5_Finish_off.png" SourceFile="Art\Screen5_Finish_off.png" />
        <EmbeddedUIResource Id="ResOfferOptimerOn" Name="OfferBar_optimer_on.png" SourceFile="Art\OfferBar_optimer_on.png" />
        <EmbeddedUIResource Id="ResOfferOptimerOff" Name="OfferBar_optimer_off.png" SourceFile="Art\OfferBar_optimer_off.png" />
        <EmbeddedUIResource Id="ResShowcaseOptimer" Name="Showcase_optimer.png" SourceFile="Art\Showcase_optimer.png" />
        <EmbeddedUIResource Id="ResOfferDevboxOn" Name="OfferBar_devbox_on.png" SourceFile="Art\OfferBar_devbox_on.png" />
        <EmbeddedUIResource Id="ResOfferDevboxOff" Name="OfferBar_devbox_off.png" SourceFile="Art\OfferBar_devbox_off.png" />
        <EmbeddedUIResource Id="ResShowcaseDevbox" Name="Showcase_devbox.png" SourceFile="Art\Showcase_devbox.png" />
        <EmbeddedUIResource Id="ResOfferPowerOn" Name="OfferBar_power_on.png" SourceFile="Art\OfferBar_power_on.png" />
        <EmbeddedUIResource Id="ResOfferPowerOff" Name="OfferBar_power_off.png" SourceFile="Art\OfferBar_power_off.png" />
        <EmbeddedUIResource Id="ResShowcasePower" Name="Showcase_power.png" SourceFile="Art\Showcase_power.png" />
        <EmbeddedUIResource Id="ResOfferTuneOn" Name="OfferBar_tune_on.png" SourceFile="Art\OfferBar_tune_on.png" />
        <EmbeddedUIResource Id="ResOfferTuneOff" Name="OfferBar_tune_off.png" SourceFile="Art\OfferBar_tune_off.png" />
        <EmbeddedUIResource Id="ResShowcaseTune" Name="Showcase_tune.png" SourceFile="Art\Showcase_tune.png" />
        <EmbeddedUIResource Id="ResOfferGateOn" Name="OfferBar_gate_on.png" SourceFile="Art\OfferBar_gate_on.png" />
        <EmbeddedUIResource Id="ResOfferGateOff" Name="OfferBar_gate_off.png" SourceFile="Art\OfferBar_gate_off.png" />
        <EmbeddedUIResource Id="ResShowcaseGate" Name="Showcase_gate.png" SourceFile="Art\Showcase_gate.png" />
      </EmbeddedUI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <!-- LeanInstallationDlg is the branded Installation stage. It is UI-only: the MSI still owns sequencing and files. -->
      <Dialog Id="LeanInstallationDlg" Width="493" Height="348" Title="Ambysto Lean — Installation">
        <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="493" Height="312" TabSkip="yes" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Title" Type="Text" X="180" Y="20" Width="110" Height="24" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installing Ambysto Lean" />
        <Control Id="Description" Type="Text" X="180" Y="52" Width="110" Height="54" Transparent="yes" NoPrefix="yes" Text="Lean is being installed for your Windows user. The right panel has more from Ambysto." />
        <Control Id="PromotionTitle" Type="Text" X="308" Y="30" Width="165" Height="24" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}More from Ambysto" />
        <Control Id="Optimer" Type="Text" X="308" Y="54" Width="165" Height="16" Transparent="yes" NoPrefix="yes" Text="Ambysto Optimer" />
        <Control Id="OptimerText" Type="Text" X="308" Y="70" Width="165" Height="26" Transparent="yes" NoPrefix="yes" Text="See which apps are using memory, CPU and disk." />
        <Control Id="OptimerOption" Type="PushButton" X="308" Y="96" Width="165" Height="20" Text="Install Optimer too">
          <Publish Property="OPTIMER_SELECTED" Value="1" />
        </Control>
        <Control Id="OptimerLink" Type="Text" X="308" Y="116" Width="165" Height="16" Transparent="yes" NoPrefix="yes" Text="Download page opens after Finish" />
        <Control Id="DevBox" Type="Text" X="308" Y="142" Width="165" Height="16" Transparent="yes" NoPrefix="yes" Text="Ambysto DevBox" />
        <Control Id="DevBoxText" Type="Text" X="308" Y="158" Width="165" Height="26" Transparent="yes" NoPrefix="yes" Text="See what your development machine is running and holding on to." />
        <Control Id="DevBoxOption" Type="PushButton" X="308" Y="184" Width="165" Height="20" Text="Install DevBox too">
          <Publish Property="DEVBOX_SELECTED" Value="1" />
        </Control>
        <Control Id="DevBoxLink" Type="Text" X="308" Y="204" Width="165" Height="16" Transparent="yes" NoPrefix="yes" Text="Download page opens after Finish" />
        <Control Id="Back" Type="PushButton" X="261" Y="321" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" X="341" Y="321" Width="56" Height="17" Default="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="421" Y="321" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="312" Width="493" Height="0" />
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LeanInstallationDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed OR PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLean" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenOptimer" Order="2" Condition="OPTIMER_SELECTED = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenDevBox" Order="3" Condition="DEVBOX_SELECTED = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <InstallUISequence>
        <Show Dialog="override WelcomeDlg" Before="ProgressDlg" Condition="NOT Installed" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Ambysto Lean" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Starts the installed app from the finish screen (a UI action: it runs as the user, after the install). -->
    <CustomAction Id="LaunchLean" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]AmbystoLean.exe&quot;" Return="asyncNoWait" />
    <!-- Opt-in sibling actions only open the fixed download pages after Finish; they never run during MSI execution. -->
    <CustomAction Id="OpenOptimer" Directory="SystemFolder" ExeCommand="&quot;[SystemFolder]rundll32.exe&quot; url.dll,FileProtocolHandler &quot;https://optimer.ambysto.com&quot;" Return="asyncNoWait" />
    <CustomAction Id="OpenDevBox" Directory="SystemFolder" ExeCommand="&quot;[SystemFolder]rundll32.exe&quot; url.dll,FileProtocolHandler &quot;https://devbox.ambysto.com&quot;" Return="asyncNoWait" />

    <!-- The uninstall entry names the install folder, so "app is gone" (docs/spec/04) can check for processes there. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- %LOCALAPPDATA%\Programs\Ambysto Lean, named outright: with Scope="perUser" (ALLUSERS empty) Windows Installer
         does not redirect the Program Files folders, which a standard user cannot write (measured 2026-10-17: error 1303). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Ambysto Lean" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(AppPublishDir)**">
        <Exclude Files="$(AppPublishDir)Assets\Fonts\*.ttf" />
      </Files>
      <ComponentRef Id="LeanFontJetBrainsMonoRegular" />
      <ComponentRef Id="LeanFontJetBrainsMonoMedium" />
      <ComponentRef Id="LeanFontJetBrainsMonoBold" />
      <ComponentRef Id="LeanFontGeistRegular" />
      <ComponentRef Id="LeanFontGeistMedium" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- The bundled fonts (ASP-12: JetBrains Mono and Geist, OFL; the licences are harvested with the other files; one component per file, as the harvest does) are private files of
         the app, in Assets\Fonts of the install folder: they are never put in the system Fonts folder. The harvest leaves them out
         and they are authored here, because ICE60 fails a file that is not versioned, is not a Font-table entry and has no
         language; DefaultLanguage="0" (neutral) gives each one a language without registering it as a system font. -->
    <Component Id="LeanFontJetBrainsMonoRegular" Directory="INSTALLFOLDER" Subdirectory="Assets\Fonts" Guid="*">
      <File Id="JetBrainsMonoRegular" Source="$(AppPublishDir)Assets\Fonts\JetBrainsMono-Regular.ttf" DefaultLanguage="0" KeyPath="yes" />
    </Component>
    <Component Id="LeanFontJetBrainsMonoMedium" Directory="INSTALLFOLDER" Subdirectory="Assets\Fonts" Guid="*">
      <File Id="JetBrainsMonoMedium" Source="$(AppPublishDir)Assets\Fonts\JetBrainsMono-Medium.ttf" DefaultLanguage="0" KeyPath="yes" />
    </Component>
    <Component Id="LeanFontJetBrainsMonoBold" Directory="INSTALLFOLDER" Subdirectory="Assets\Fonts" Guid="*">
      <File Id="JetBrainsMonoBold" Source="$(AppPublishDir)Assets\Fonts\JetBrainsMono-Bold.ttf" DefaultLanguage="0" KeyPath="yes" />
    </Component>
    <Component Id="LeanFontGeistRegular" Directory="INSTALLFOLDER" Subdirectory="Assets\Fonts" Guid="*">
      <File Id="GeistRegular" Source="$(AppPublishDir)Assets\Fonts\Geist-Regular.ttf" DefaultLanguage="0" KeyPath="yes" />
    </Component>
    <Component Id="LeanFontGeistMedium" Directory="INSTALLFOLDER" Subdirectory="Assets\Fonts" Guid="*">
      <File Id="GeistMedium" Source="$(AppPublishDir)Assets\Fonts\Geist-Medium.ttf" DefaultLanguage="0" KeyPath="yes" />
    </Component>

    <!-- The user's Start Menu\Programs. The shortcut carries the app's notification id (System.AppUserModel.ID). No toast
         activator (owner, 2026-10-22): the app serves none, so a ToastActivatorCLSID would start a second instance on a click;
         an upgrade removes the older builds' activator registration with their component. A per-user component needs a
         registry key path: a value of Lean's own key. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="LeanShortcut" Name="Ambysto Lean" Target="[INSTALLFOLDER]AmbystoLean.exe" WorkingDirectory="INSTALLFOLDER" Icon="LeanIcon.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Ambysto.Lean" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Ambysto\Lean" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
