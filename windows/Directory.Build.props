<Project>
  <!-- Shared settings for Ambysto Lean on Windows (as the Kit's). docs/spec/ and the intent are the contract; the Swift
       code is never read. Each project sets its own target framework. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- ASP-33: the Pro features are a private module. Present on disk (the private repository) the build includes it; absent
       (the public repository) the build has no Pro features. -p:LeanPro=false builds the public variant from the private tree. -->
  <PropertyGroup>
    <LeanPro Condition="'$(LeanPro)' == '' And Exists('$(MSBuildThisFileDirectory)pro\Ambysto.Lean.Pro\Ambysto.Lean.Pro.csproj')">true</LeanPro>
  </PropertyGroup>
</Project>
