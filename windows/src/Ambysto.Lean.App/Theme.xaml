    <!-- High Contrast: nothing is overridden, so every control uses the system's colours; the sidebar's ground is the system's window colour. -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="LeanSidebarFill" Color="{ThemeResource SystemColorWindowColor}" />
      <!-- ASP-18: the dividers of the top band take the system's disabled text colour. -->
      <SolidColorBrush x:Key="LeanDividerFill" Color="{ThemeResource SystemColorGrayTextColor}" />
      <!-- ASP-22: no band; a 1px divider between table columns in the disabled text colour. -->
      <SolidColorBrush x:Key="LeanColumnBandFill" Color="Transparent" />
      <SolidColorBrush x:Key="LeanColumnDividerFill" Color="{ThemeResource SystemColorGrayTextColor}" />
