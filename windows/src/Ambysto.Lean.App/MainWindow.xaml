<Window
    x:Class="Ambysto.Lean.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ambysto.Lean.App">
  <!-- Every visible string is set in MainWindow.xaml.cs from Copy.Text (docs/spec/07); this file holds layout and automation ids only. -->
  <!-- Transparent, not none: empty space only takes part in hit testing with a background, and the mouse's back button (ASP-9) is read
       on this root wherever it is pressed. -->
  <Grid RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The sidebar (ASP-14): the app name, the six views, and Settings and About at the bottom. Each item is a button with a glyph
         and its label, built in MainWindow.Sidebar.cs; the current one has a 2px ink bar on its left and the ground behind it. -->
    <local:GroupGrid x:Name="Sidebar" Grid.Column="0" Grid.RowSpan="3" Width="220" AutomationProperties.AutomationId="Sidebar"
                     Background="{ThemeResource LeanSidebarFill}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                     BorderThickness="0,0,1.5,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="22,22,16,22" Style="{StaticResource LeanTitle}" AutomationProperties.AutomationId="SidebarTitle">
        <Run x:Name="BrandRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text=" " /><Run x:Name="ProductRun" FontFamily="{StaticResource LeanMonoBold}" FontWeight="Bold" Foreground="{StaticResource LeanToneBrush}" />
      </TextBlock>
      <StackPanel Grid.Row="1" Spacing="2">
        <Button x:Name="OverviewButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="Overview" Click="OnOverviewClick" />
        <Button x:Name="LargeOldButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="LargeOld" Click="OnLargeOldClick" />
        <Button x:Name="TemporaryFilesButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="TemporaryFiles" Click="OnTemporaryFilesClick" />
        <Button x:Name="DuplicatesButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="Duplicates" Click="OnDuplicatesClick" />
        <Button x:Name="UninstallButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="Uninstall" Click="OnUninstallClick" />
        <Button x:Name="AppsAndCachesButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="AppsAndCaches" Click="OnAppsAndCachesClick" />
        <Button x:Name="HistoryButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="History" Click="OnHistoryClick" />
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,12">
        <Button x:Name="SettingsButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="Settings" Click="OnSettingsClick" />
        <Button x:Name="AboutButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="About" Click="OnAboutClick" />
        <Button x:Name="BuyCoffeeButton" Style="{StaticResource LeanSidebarItem}" AutomationProperties.AutomationId="BuyCoffee" Click="OnBuyCoffeeClick" />
      </StackPanel>
    </local:GroupGrid>

    <!-- The move bar (plan group 11): Cancel while the Trasher runs, and the report of the last move with Put back of its session. It sits
         under every view, so the report stays on screen while the user looks at another view. A collapsed element is absent from UI Automation. -->
    <StackPanel x:Name="MoveBar" Grid.Row="1" Grid.Column="1" Margin="16,0,16,8" Spacing="6">
      <Button x:Name="CancelMovingButton" AutomationProperties.AutomationId="CancelMoving" Visibility="Collapsed" Click="OnCancelMovingClick" />
      <local:GroupPanel x:Name="MoveReport" Visibility="Collapsed" Spacing="4" AutomationProperties.AutomationId="MoveReport">
        <TextBlock x:Name="MovedSummaryText" AutomationProperties.AutomationId="MovedSummary" TextWrapping="Wrap" />
        <TextBlock x:Name="SpaceReturnsText" AutomationProperties.AutomationId="SpaceReturns" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ReportRows" Spacing="2" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="PutBackSessionButton" AutomationProperties.AutomationId="PutBackSession" Click="OnPutBackSessionClick" />
          <Button x:Name="CloseReportButton" AutomationProperties.AutomationId="CloseReport" Click="OnCloseReportClick" />
        </StackPanel>
      </local:GroupPanel>
    </StackPanel>

    <!-- The status line stays on screen in every view: the duplicates search and the app-gone watch report there (plan group 8b). -->
    <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="1" Margin="16,0,16,12" TextWrapping="Wrap" AutomationProperties.AutomationId="Status" />

    <Grid x:Name="ViewHost" Grid.Row="0" Grid.Column="1">
      <Grid x:Name="MainContent" Padding="16,12,16,8" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the volume card (it appears, collapsed until then, once its numbers are read) and, once a map is shown, Scan again and
             Scan a folder at the top right. The card's contents wrap inside it when the window is narrow: JetBrains Mono (ASP-12) is wider
             than the system font. -->
        <Grid Grid.Row="0" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <local:GroupPanel x:Name="CardPanel" Grid.Column="0" HorizontalAlignment="Left" Visibility="Collapsed" Style="{StaticResource LeanCard}" Padding="14,8,14,8"
                            AutomationProperties.AutomationId="VolumeCard">
            <!-- ASP-18: a divider in the gap before each item but the first; the panel leaves it out where its item starts a line. -->
            <local:WrapPanel HorizontalSpacing="32" VerticalSpacing="8" CenterLines="True">
              <TextBlock x:Name="UsedText" AutomationProperties.AutomationId="UsedByThisVolume" />
              <local:BandDivider Width="2" Height="22" CornerRadius="1" Background="{ThemeResource LeanDividerFill}" IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="FreeText" AutomationProperties.AutomationId="FreeRightNow" />
              <local:BandDivider Width="2" Height="22" CornerRadius="1" Background="{ThemeResource LeanDividerFill}" IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="BinText" AutomationProperties.AutomationId="InTheRecycleBin" />
              <local:BandDivider Width="2" Height="22" CornerRadius="1" Background="{ThemeResource LeanDividerFill}" IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw" />
              <Button x:Name="RecycleBinButton" AutomationProperties.AutomationId="OpenRecycleBin" Click="OnOpenRecycleBinClick" />
            </local:WrapPanel>
          </local:GroupPanel>
          <StackPanel x:Name="TopActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Visibility="Collapsed">
            <Button x:Name="ScanAgainButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="Scan" Click="OnScanAgainClick" />
            <Button x:Name="ScanFolderButton" AutomationProperties.AutomationId="ScanFolder" Click="OnScanFolderClick" />
          </StackPanel>
        </Grid>

        <!-- Row 1: the scan's progress line with Cancel (state 2), or the refusal of a folder on another drive. The progress line is a polite
             live region, set at most once a second. -->
        <Grid x:Name="ProgressRow" Grid.Row="1" ColumnSpacing="12" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ScanProgressText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanProgress"
                     AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="CancelButton" Grid.Column="1" AutomationProperties.AutomationId="Cancel" Click="OnCancelClick" IsEnabled="False" Visibility="Collapsed" />
        </Grid>

        <!-- The start state (ASP-14): the Scan circle, the line under it, and a card for every fixed drive. It takes the rows of the map,
             which is collapsed until a scan starts. -->
        <ScrollViewer x:Name="StartScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="StartPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
          <Button x:Name="ScanButton" Style="{StaticResource LeanScanCircle}" Width="160" Height="160" HorizontalAlignment="Center"
                  AutomationProperties.AutomationId="Scan" Click="OnScanClick">
            <TextBlock x:Name="ScanCircleLabel" Style="{StaticResource LeanTitle}" />
          </Button>
          <local:GroupPanel x:Name="ScanHint" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <TextBlock x:Name="ScanHintText" Style="{StaticResource LeanSentence}" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="ScanFolderLink" Padding="0" VerticalAlignment="Center" AutomationProperties.AutomationId="ScanFolder" Click="OnScanFolderClick" />
          </local:GroupPanel>
          <!-- ASP-22: the cards wrap onto a new line when the window is narrow; the whole start screen scrolls if it is still too high. -->
          <local:GroupPanel x:Name="DriveCards" HorizontalAlignment="Center" Margin="0,24,0,0"
                            Visibility="Collapsed" AutomationProperties.AutomationId="DriveCards">
            <local:WrapPanel x:Name="DriveCardRow" HorizontalSpacing="12" VerticalSpacing="12" StretchLines="True" />
          </local:GroupPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- The scanning and scanned states (ASP-14). On the left the type column (scanned only); on the right, from the top: the terminal
             readout (scanning only), the breadcrumbs, the map (55 %), its legend, a 1px rule and the largest files (45 %, scanned only). -->
        <Grid x:Name="ResultsGrid" Grid.Row="2" ColumnSpacing="16" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <local:GroupPanel x:Name="TypeColumn" Grid.Column="0" Width="252" Padding="0,0,12,0" Spacing="8" Visibility="Collapsed"
                            BorderBrush="{ThemeResource LeanDividerFill}" BorderThickness="0,0,1.5,0"
                            AutomationProperties.AutomationId="TypeGroups">
            <ListView x:Name="TypeGroups" SelectionMode="Single" AutomationProperties.AutomationId="TypeGroupList" SelectionChanged="OnTypeGroupChanged" />
            <!-- Text only (a TextBlock, not a row of the list): it cannot be chosen. -->
            <TextBlock x:Name="FreeSpaceRow" Margin="12,0,12,0" Style="{StaticResource LeanMuteText}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="FreeSpace" />
            <!-- What the finished scan measured against what the volume uses, and what it could not read. -->
            <TextBlock x:Name="ProgressText" Margin="12,8,12,0" Style="{StaticResource LeanNote}" TextWrapping="Wrap" AutomationProperties.AutomationId="Progress" />
          </local:GroupPanel>

          <Grid x:Name="ResultsRight" Grid.Column="1" RowSpacing="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="MapRow" Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="ListRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- The terminal readout (ASP-14): the prompt with its block cursor, the folder being read, a 40-cell meter, and the last six zones. -->
            <local:GroupGrid x:Name="ScanReadout" Grid.Row="0" Margin="0,0,0,8" Padding="16,12,16,12" Visibility="Collapsed" CornerRadius="8"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.AutomationId="ScanReadout">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock x:Name="ScanPromptText" AutomationProperties.AutomationId="ScanPrompt" Style="{StaticResource LeanData}" />
                  <Border x:Name="ScanCursor" Width="9" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="ScanCursor"
                          Background="{StaticResource LeanToneBrush}" />
                </StackPanel>
                <TextBlock x:Name="ScanReadingText" AutomationProperties.AutomationId="ScanReading" Style="{StaticResource LeanMuteText}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <local:GroupPanel x:Name="ScanMeter" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" AutomationProperties.AutomationId="ScanMeter" />
                  <TextBlock x:Name="ScanPercentText" Style="{StaticResource LeanData}" VerticalAlignment="Center" />
                </StackPanel>
                <local:GroupPanel x:Name="ScanLog" Spacing="0" AutomationProperties.AutomationId="ScanLog" />
              </StackPanel>
              <Canvas x:Name="Scanlines" IsHitTestVisible="False" Visibility="Collapsed" />
            </local:GroupGrid>

            <StackPanel x:Name="Breadcrumb" Grid.Row="1" Margin="0,0,0,6" Orientation="Horizontal" Spacing="4" />

            <local:MapCanvas x:Name="MapArea" Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" TabFocusNavigation="Once"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="OnMapSizeChanged"
                             AutomationProperties.AutomationId="Map" />

            <!-- Wraps to a second line when the entries do not fit the pane, so none is cut off. -->
            <local:WrapPanel x:Name="Legend" Grid.Row="3" Margin="0,6,0,0" HorizontalSpacing="16" VerticalSpacing="4" />

            <Border x:Name="ResultsRule" Grid.Row="4" Height="2" Margin="0,8,0,8" BorderThickness="0,1.5,0,0" Visibility="Collapsed"
                    BorderBrush="{ThemeResource LeanDividerFill}" />

            <!-- The largest files of the chosen group (ASP-14): a table with a tick box per row, nothing ticked, and Move to Recycle Bin. -->
            <Grid x:Name="LargestPanel" Grid.Row="5" RowSpacing="6" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <local:LeanTable x:Name="LargestTable" Grid.Row="0" AutomationProperties.AutomationId="LargestFiles" ListId="LargestFilesList" />
              <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MoveLargestButton" Grid.Column="0" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveLargest"
                        IsEnabled="False" VerticalAlignment="Center" Click="OnMoveLargestClick" />
                <TextBlock x:Name="LargestNote" Grid.Column="1" Style="{StaticResource LeanSentence}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="LargestFilesNote" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- The Settings and About views (plan group 8): one at a time, in place of the main content, which keeps its scan. A collapsed view is
           absent from UI Automation. Pro-only controls are disabled in Free and carry a quiet "Pro" label (docs/spec/06). -->
      <local:GroupPanel x:Name="SettingsView" Visibility="Collapsed" Padding="16" Spacing="12" MaxWidth="640" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="SettingsView">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="SettingsTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid HorizontalAlignment="Left" Margin="0,2,8,0">
          <CheckBox x:Name="OpenAtLoginBox" AutomationProperties.AutomationId="OpenAtLogin" MinWidth="0" Padding="8,0,28,0" IsEnabled="False" Click="OnOpenAtLoginClick" />
          <Border x:Name="OpenAtLoginProBadge" Style="{StaticResource LeanProBadge}" Margin="0,-3,-4,0"
                  Visibility="{x:Bind OpenAtLoginProLabel.Visibility, Mode=OneWay}">
            <TextBlock x:Name="OpenAtLoginProLabel" AutomationProperties.AutomationId="OpenAtLoginProLabel" Style="{StaticResource LeanProSticker}" />
          </Border>
        </Grid>
        <Grid HorizontalAlignment="Left" Margin="0,2,8,0">
          <CheckBox x:Name="LowDiskAlertBox" AutomationProperties.AutomationId="LowDiskAlertToggle" MinWidth="0" Padding="8,0,28,0" IsEnabled="False" Click="OnLowDiskAlertClick" />
          <Border x:Name="LowDiskAlertProBadge" Style="{StaticResource LeanProBadge}" Margin="0,-3,-4,0"
                  Visibility="{x:Bind LowDiskAlertProLabel.Visibility, Mode=OneWay}">
            <TextBlock x:Name="LowDiskAlertProLabel" AutomationProperties.AutomationId="LowDiskAlertToggleProLabel" Style="{StaticResource LeanProSticker}" />
          </Border>
        </Grid>
        <Grid HorizontalAlignment="Left" Margin="0,4,8,0">
          <Button x:Name="ExportButton" Style="{StaticResource LeanSuggestButton}" AutomationProperties.AutomationId="ExportReport" IsEnabled="False" Click="OnExportClick" />
          <Border x:Name="ExportProBadge" Style="{StaticResource LeanProBadge}"
                  Visibility="{x:Bind ExportProLabel.Visibility, Mode=OneWay}">
            <TextBlock x:Name="ExportProLabel" AutomationProperties.AutomationId="ExportReportProLabel" Style="{StaticResource LeanProSticker}" />
          </Border>
        </Grid>
        <Button x:Name="CancelExportButton" AutomationProperties.AutomationId="CancelExport" Visibility="Collapsed" Click="OnCancelExportClick" />
        <TextBlock x:Name="SettingsMessage" AutomationProperties.AutomationId="SettingsMessage" TextWrapping="Wrap" />
        <!-- The user's protected folders (v1 additions, docs/spec/02 Windows note): saved at once, and every gate and hint reads them. -->
        <TextBlock x:Name="ProtectedFoldersHeading" FontSize="16" />
        <TextBlock x:Name="ProtectedFoldersNote" TextWrapping="Wrap" Style="{StaticResource LeanSentence}" />
        <ListView x:Name="ProtectedFoldersList" SelectionMode="Single" MaxHeight="160" AutomationProperties.AutomationId="ProtectedFoldersList"
                  SelectionChanged="OnProtectedFolderSelectionChanged" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AddProtectedFolderButton" AutomationProperties.AutomationId="AddProtectedFolder" Click="OnAddProtectedFolderClick" />
          <Button x:Name="RemoveProtectedFolderButton" AutomationProperties.AutomationId="RemoveProtectedFolder" IsEnabled="False"
                  Click="OnRemoveProtectedFolderClick" />
        </StackPanel>
        <TextBlock x:Name="ProtectedFoldersMessage" AutomationProperties.AutomationId="ProtectedFoldersMessage" TextWrapping="Wrap" />
      </local:GroupPanel>

      <ScrollViewer x:Name="AboutView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="AboutView">
        <local:GroupPanel Padding="16" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch">
          <TextBlock x:Name="AboutTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Image x:Name="AboutLogoImage" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.AutomationId="AboutLogo" />
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="AboutAppNameText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="AboutAppName" />
              <TextBlock x:Name="VersionText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="Version" />
              <TextBlock x:Name="AboutDeveloperText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="AboutDeveloper" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="WebsiteButton" AutomationProperties.AutomationId="Website" Click="OnWebsiteClick" />
          <TextBlock x:Name="WebsiteMessage" Style="{StaticResource LeanSentence}" Visibility="Collapsed" TextWrapping="Wrap" />
          <Button x:Name="StarOnGitHubButton" AutomationProperties.AutomationId="StarOnGitHub" Click="OnStarOnGitHubClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <!-- GitHub mark (Octicons mark-github, MIT); decorative, the button's name comes from its text. -->
              <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Path Width="16" Height="16" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                      Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.66 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
              </Viewbox>
              <TextBlock x:Name="StarOnGitHubLabel" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="StarOnGitHubMessage" Style="{StaticResource LeanSentence}" Visibility="Collapsed" TextWrapping="Wrap" />
          <Button x:Name="CheckForUpdatesButton" AutomationProperties.AutomationId="CheckForUpdates" Click="OnCheckForUpdatesClick" />
          <TextBlock x:Name="UpdateStatusText" Style="{StaticResource LeanSentence}" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateStatus"
                     AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
          <TextBlock x:Name="AboutPaymentText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="AboutPayment" TextWrapping="Wrap" />
          <TextBox x:Name="LicenseKeyBox" AutomationProperties.AutomationId="LicenseKey" />
          <Button x:Name="ActivateButton" AutomationProperties.AutomationId="ActivateKey" Click="OnActivateKeyClick" />
          <TextBlock x:Name="LicenseStatusText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="LicenseStatus"
                     AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
          <TextBlock x:Name="RegisteredToText" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="RegisteredTo" Visibility="Collapsed" />
        </local:GroupPanel>
      </ScrollViewer>

      <!-- The Large and old, Duplicates and Uninstall views (plan group 8b): like Settings, one at a time in place of the main content.
           Each list scrolls inside its view. Nothing here moves or opens a file except the row menu's Reveal, through the launcher. -->
      <local:GroupGrid x:Name="LargeOldView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="LargeOldView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="LargeOldTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
          <ComboBox x:Name="MinimumSizeBox" AutomationProperties.AutomationId="MinimumSize" MinWidth="140" SelectionChanged="OnLargeOldChoiceChanged" />
          <ComboBox x:Name="MinimumAgeBox" AutomationProperties.AutomationId="MinimumAge" MinWidth="140" SelectionChanged="OnLargeOldChoiceChanged" />
          <!-- Show system items (ASP-14): moved here from the main window, because this is the only list it changes. -->
          <CheckBox x:Name="SystemItemsBox" AutomationProperties.AutomationId="ShowSystemItems" MinWidth="0" VerticalAlignment="Bottom" Click="OnSystemItemsClick" />
          <!-- ASP-17: shown only while Suggest's own list is on screen; it brings the filtered list back. -->
          <Button x:Name="ClearSuggestionButton" AutomationProperties.AutomationId="ClearSuggestion" VerticalAlignment="Bottom" Visibility="Collapsed"
                  Click="OnClearSuggestionClick" />
        </StackPanel>
        <TextBlock x:Name="LargeOldMessage" Grid.Row="2" TextWrapping="Wrap" />
        <local:LeanTable x:Name="LargeOldTable" Grid.Row="3" ListId="LargeOldList" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
          <Button x:Name="MoveLargeOldButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveLargeOld" IsEnabled="False" Click="OnMoveLargeOldClick" />
          <!-- ASP-17: Suggest (Pro); in Free it is disabled and carries the corner "Pro" sticker badge (docs/spec/06). -->
          <Grid Margin="0,0,6,0">
            <Button x:Name="SuggestLargeOldButton" Style="{StaticResource LeanSuggestButton}" AutomationProperties.AutomationId="Suggest" IsEnabled="False" Click="OnSuggestLargeOldClick" />
            <Border x:Name="SuggestLargeOldProBadge" Style="{StaticResource LeanProBadge}"
                    Visibility="{x:Bind SuggestLargeOldProLabel.Visibility, Mode=OneWay}">
              <TextBlock x:Name="SuggestLargeOldProLabel" AutomationProperties.AutomationId="SuggestProLabel" Style="{StaticResource LeanProSticker}" />
            </Border>
          </Grid>
        </StackPanel>
      </local:GroupGrid>

      <!-- Temporary files (v1 additions, docs/spec/03): the old children of the temporary folders, none ticked. -->
      <local:GroupGrid x:Name="TempView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="TempView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="TempTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <ComboBox x:Name="AgeChoice" Grid.Row="1" AutomationProperties.AutomationId="AgeChoice" MinWidth="200" SelectionChanged="OnTempAgeChanged" />
        <TextBlock x:Name="TempMessage" Grid.Row="2" TextWrapping="Wrap" />
        <local:LeanTable x:Name="TempTable" Grid.Row="3" ListId="TempList" />
        <TextBlock x:Name="TempTotal" Grid.Row="4" TextWrapping="Wrap" AutomationProperties.AutomationId="TempTotal" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
          <Button x:Name="MoveTempButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveTemp" IsEnabled="False" Click="OnMoveTempClick" />
          <Grid Margin="0,0,6,0">
            <Button x:Name="SuggestTempButton" Style="{StaticResource LeanSuggestButton}" AutomationProperties.AutomationId="Suggest" IsEnabled="False" Click="OnSuggestTempClick" />
            <Border x:Name="SuggestTempProBadge" Style="{StaticResource LeanProBadge}"
                    Visibility="{x:Bind SuggestTempProLabel.Visibility, Mode=OneWay}">
              <TextBlock x:Name="SuggestTempProLabel" AutomationProperties.AutomationId="SuggestProLabel" Style="{StaticResource LeanProSticker}" />
            </Border>
          </Grid>
        </StackPanel>
      </local:GroupGrid>

      <local:GroupGrid x:Name="DuplicatesView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="DuplicatesView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="DuplicatesTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="FindDuplicatesButton" AutomationProperties.AutomationId="FindDuplicates" Click="OnFindDuplicatesClick" />
          <Button x:Name="CancelDuplicatesButton" AutomationProperties.AutomationId="CancelDuplicates" IsEnabled="False" Click="OnCancelDuplicatesClick" />
          <ProgressRing x:Name="DuplicatesRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="DuplicatesMessage" Grid.Row="2" TextWrapping="Wrap" />
        <!-- The type tabs (ASP-15): All files and the seven groups of spec 01, each with its number of groups, built in MainWindow.Duplicates.cs;
             they wrap onto a second line when the window is narrow. Collapsed until a search has found groups. -->
        <local:GroupGrid x:Name="DuplicateTypes" Grid.Row="3" Visibility="Collapsed" AutomationProperties.AutomationId="DuplicateTypes">
          <local:WrapPanel x:Name="DuplicateTypeTabs" HorizontalSpacing="4" VerticalSpacing="4" />
        </local:GroupGrid>
        <!-- Virtualised: only the groups on screen have elements; each is built when the repeater realises it. A repeater, not a list:
             a group is not a list item, so the table inside it is the only list (ASP-10). -->
        <ScrollViewer x:Name="DuplicatesScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto">
          <ItemsRepeater x:Name="DuplicatesList" ElementPrepared="OnDuplicatesElementPrepared">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
          <Button x:Name="MoveDuplicatesButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveToRecycleBin" IsEnabled="False" Click="OnMoveDuplicatesClick" />
          <!-- Select by rule (ASP-15): a drop-down beside Move; its menu is built in MainWindow.Duplicates.cs. -->
          <DropDownButton x:Name="SelectByRuleButton" AutomationProperties.AutomationId="SelectByRule" IsEnabled="False" />
          <!-- ASP-17: Suggest (Pro) runs the Newest rule on the tab shown, after Select by rule. -->
          <Grid Margin="0,0,6,0">
            <Button x:Name="SuggestDuplicatesButton" Style="{StaticResource LeanSuggestButton}" AutomationProperties.AutomationId="Suggest" IsEnabled="False" Click="OnSuggestDuplicatesClick" />
            <Border x:Name="SuggestDuplicatesProBadge" Style="{StaticResource LeanProBadge}"
                    Visibility="{x:Bind SuggestDuplicatesProLabel.Visibility, Mode=OneWay}">
              <TextBlock x:Name="SuggestDuplicatesProLabel" AutomationProperties.AutomationId="SuggestProLabel" Style="{StaticResource LeanProSticker}" />
            </Border>
          </Grid>
        </StackPanel>
      </local:GroupGrid>

      <local:GroupGrid x:Name="UninstallView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="UninstallView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="UninstallTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <!-- ASP-16: the apps as a table with single selection; its columns and rows are made in MainWindow.Views.cs. -->
        <local:LeanTable x:Name="UninstallTable" Grid.Row="1" ListId="UninstallList" />
        <!-- The button, and beside it the selected app's class note (ASP-16: not in the row, which keeps the whole name). A Store app has the note alone. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
          <Button x:Name="UninstallInSettingsButton" Visibility="Collapsed" AutomationProperties.AutomationId="UninstallInSettings"
                  Click="OnUninstallInSettingsClick" />
          <TextBlock x:Name="UninstallNote" Style="{StaticResource LeanNote}" VerticalAlignment="Center" Visibility="Collapsed"
                     AutomationProperties.AutomationId="UninstallNote" />
        </StackPanel>
        <TextBlock x:Name="UninstallInstruction" Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="UninstallInstruction" />
        <!-- The leftovers of the app that is gone (plan group 11): one row per candidate with a Move box, nothing ticked. -->
        <TextBlock x:Name="LeftoverMessage" Grid.Row="4" TextWrapping="Wrap" />
        <local:LeanTable x:Name="LeftoverTable" Grid.Row="5" MaxHeight="240" Visibility="Collapsed" ListId="LeftoverList" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
          <Button x:Name="MoveLeftoversButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveLeftovers" Visibility="Collapsed" IsEnabled="False" Click="OnMoveLeftoversClick" />
        </StackPanel>
      </local:GroupGrid>

      <!-- Apps and caches (ASP-20 phase B, docs/spec/05, 06): the catalog's rows. A command row is cleared by the tool's own command after
           ConfirmClear; a guide row is shown only. Free sees the rows; the tick boxes, Clear and Suggest are Pro. -->
      <local:GroupGrid x:Name="AppsView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="AppsView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock x:Name="AppsTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
          <!-- The default Caches tab and the four diagnosis tabs share this view. -->
          <local:GroupGrid x:Name="AppsSections" VerticalAlignment="Center" AutomationProperties.AutomationId="AppsSection">
            <local:WrapPanel x:Name="AppsSectionTabs" HorizontalSpacing="4" VerticalSpacing="4" />
          </local:GroupGrid>
        </StackPanel>
        <TextBlock x:Name="AppsMessage" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.AutomationId="AppsMessage" />
        <TextBlock x:Name="SpaceMessage" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="SpaceMessage" />
        <TextBlock x:Name="DisksMessage" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="DisksMessage" />
        <TextBlock x:Name="DeveloperMessage" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="DeveloperMessage" />
        <TextBlock x:Name="InstallersMessage" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="InstallersMessage" />
        <local:LeanTable x:Name="AppsTable" Grid.Row="2" ListId="AppsList" />
        <local:LeanTable x:Name="SpaceTable" Grid.Row="2" Visibility="Collapsed" AutomationProperties.AutomationId="SpaceTable" ListId="SpaceList" />
        <local:LeanTable x:Name="DisksTable" Grid.Row="2" Visibility="Collapsed" AutomationProperties.AutomationId="DisksTable" ListId="DisksList" />
        <ScrollViewer x:Name="DeveloperScroll" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
          <local:LeanTable x:Name="DeveloperTable" MinWidth="760" Visibility="Collapsed" AutomationProperties.AutomationId="DeveloperTable" ListId="DeveloperList" />
        </ScrollViewer>
        <ScrollViewer x:Name="InstallersScroll" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
          <local:LeanTable x:Name="InstallersTable" MinWidth="800" Visibility="Collapsed" AutomationProperties.AutomationId="InstallersTable" ListId="InstallersList" />
        </ScrollViewer>
        <!-- One line per command that ran, under the table; it stays while the rows are read again. -->
        <ScrollViewer x:Name="AppsReportScroll" Grid.Row="3" MaxHeight="120" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="AppsReport" Spacing="2" />
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
          <StackPanel x:Name="AppsClearBar" Orientation="Horizontal" Spacing="12">
            <Grid Margin="0,0,4,0">
              <Button x:Name="ClearAppsButton" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="ClearApps" IsEnabled="False" Click="OnClearAppsClick" />
              <Border x:Name="ClearAppsProBadge" Style="{StaticResource LeanProBadge}"
                      Visibility="{x:Bind ClearAppsProLabel.Visibility, Mode=OneWay}">
                <TextBlock x:Name="ClearAppsProLabel" AutomationProperties.AutomationId="ClearAppsProLabel" Style="{StaticResource LeanProSticker}" />
              </Border>
            </Grid>
            <Grid Margin="0,0,4,0">
              <Button x:Name="SuggestAppsButton" Style="{StaticResource LeanSuggestButton}" AutomationProperties.AutomationId="SuggestApps" IsEnabled="False" Click="OnSuggestAppsClick" />
              <Border x:Name="SuggestAppsProBadge" Style="{StaticResource LeanProBadge}"
                      Visibility="{x:Bind SuggestAppsProLabel.Visibility, Mode=OneWay}">
                <TextBlock x:Name="SuggestAppsProLabel" AutomationProperties.AutomationId="SuggestProLabel" Style="{StaticResource LeanProSticker}" />
              </Border>
            </Grid>
          </StackPanel>
          <Button x:Name="MoveInstallersButton" Visibility="Collapsed" Style="{StaticResource LeanPrimaryButton}" AutomationProperties.AutomationId="MoveInstallers" IsEnabled="False" Click="OnMoveInstallersClick" />
          <Button x:Name="RefreshAppsButton" AutomationProperties.AutomationId="RefreshApps" Click="OnRefreshAppsClick" />
        </StackPanel>
      </local:GroupGrid>

      <!-- The History view (plan group 11, docs/spec/05, 06): the journal's sessions, newest first, built when a container is realised. -->
      <local:GroupGrid x:Name="HistoryView" Visibility="Collapsed" Padding="16" RowSpacing="12" AutomationProperties.AutomationId="HistoryView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="HistoryTitle" Style="{StaticResource LeanTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="HistoryNote" Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource LeanSentence}" AutomationProperties.AutomationId="HistoryFreeLimit" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsRepeater x:Name="HistoryList" ElementPrepared="OnHistoryElementPrepared">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </local:GroupGrid>
    </Grid>
  </Grid>
</Window>
